# ---------- 依赖 ----------
node_modules/
.pnpm-store/
target/

# 安装前旧依赖目录的本地残留（待手动删除，勿提交）
_node_modules_stale/

# ---------- 构建产物 ----------
dist/
build/
apps/*/dist/
apps/*/build/
*.tsbuildinfo

# ---------- Tauri ----------
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/target/

# 库 crate 的 lock 不入库（只有最终产物 apps/desktop/src-tauri 的 Cargo.lock 需要锁定）
packages/ai-core/Cargo.lock

# ---------- 第三方 SDK 本体 ----------
# Cubism SDK 不允许随包再分发（工程计划 §11），由使用者自行下载。
# 只保留目录里的说明文档，本体一律不入库。
apps/renderer/vendor/*.js

# ---------- 角色资产 ----------
# 二进制素材（moc3 / 贴图 / 动作）体积大，且各自受授权条款约束，走独立分发，不入库。
# manifest.json 等文本元数据**仍入库**：它是构建期校验的输入，
# 丢了就无法在 CI 或新克隆里验证角色包结构。
assets/characters/*/runtime/
assets/characters/*/*.moc3
assets/characters/*/*.cmo3
assets/characters/*/*.can3
assets/characters/*/*.png
# Live2D 运行时配置与动作/表情数据。随模型包一起分发，不属于"结构元数据"：
# 它们体量大（单个 motion3 常有十几 KB，一个模型十几个），且与美术产出强绑定。
# 只有 runtime/ 之外平铺布局的角色包会撞上这几条，先立规则免得悄悄混进仓库。
assets/characters/*/*.model3.json
assets/characters/*/*.motion3.json
assets/characters/*/*.exp3.json
assets/characters/*/*.physics3.json
assets/characters/*/*.cdi3.json

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example
*.local
secrets/

# ---------- 代码签名证书（绝不入库）----------
*.pfx
*.p12
*.key
*.keystore
signing/

# ---------- 日志与运行时 ----------
*.log
logs/
runtime/

# ---------- 测试与缓存 ----------
coverage/
.vitest/
playwright-report/

# ---------- 编辑器与工具缓存 ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# IDE 项目数据（本地会话与索引，不入库）
.codebuddy/
# 构建工具缓存
.vite/
.eslintcache
