{
  "name": "heart-star",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate:characters": "pnpm --filter @heart-star/character-schema exec tsx src/cli.ts",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "gen:rust": "pnpm --filter @heart-star/protocol gen:rust"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "typescript": "^5.5.4"
  }
}
