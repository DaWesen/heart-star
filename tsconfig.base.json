{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@heart-star/character-schema": ["packages/character-schema/src/index.ts"],
      "@heart-star/protocol": ["packages/protocol/src/index.ts"]
    },
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "isolatedModules": true
  }
}
